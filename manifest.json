{
  "manifest_version": 3,
  "name": "Jira Time Tracker for uHub",
  "version": "1.0.0",
  "description": "Time the Jira ticket you are working on and log it to the ticket when you stop.",
  "icons": {
    "16": "icons/logo-16.png",
    "32": "icons/logo-32.png",
    "48": "icons/logo-48.png",
    "96": "icons/logo-96.png",
    "128": "icons/logo-128.png"
  },
  "action": {
    "default_title": "Jira Time Tracker for uHub",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/idle-16.png",
      "32": "icons/idle-32.png",
      "48": "icons/idle-48.png"
    }
  },
  "permissions": [
    "storage",
    "alarms",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "https://jira.uhub.biz/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "jira-time-tracker@uhub.local",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "authenticationInfo"
        ]
      }
    }
  }
}
